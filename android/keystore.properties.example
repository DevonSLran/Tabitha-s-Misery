# Copy to android/keystore.properties and fill in the passwords.
# That file is gitignored — never commit it, and never commit the .jks itself.
#
# Generate the keystore first (see README, "Releasing the Android app"):
#   keytool -genkeypair -v -keystore ~/.android-keystores/tabitha-release.jks \
#     -alias tabitha -keyalg RSA -keysize 4096 -validity 10000 -storetype PKCS12

# Absolute path, deliberately outside the repo so no gitignore mistake can
# ever commit the key.
storeFile=/home/devon/.android-keystores/tabitha-release.jks
storePassword=
keyAlias=tabitha
keyPassword=
