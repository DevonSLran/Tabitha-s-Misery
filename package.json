{
  "name": "bca-finance-app",
  "version": "1.0.0",
  "description": "",
  "main": "js/app.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/app.css -o css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/app.css -o css/app.css --watch",
    "copy": "npm run build:css && rm -rf www && mkdir -p www && cp *.html www/ && cp -r css js fonts vendor www/",
    "check:rls": "node scripts/check-rls.js",
    "sync:fn": "cp js/format.js supabase/functions/_shared/tm/format.js",
    "test": "node supabase/functions/import-bca-emails/parser.test.ts && node --test supabase/functions/_shared/tm/core.test.mjs && node scripts/check-rls.js",
    "sync": "npm run copy && cap sync android",
    "open": "cap open android",
    "build:android": "npm run copy && cap sync android && cap build android",
    "build:apk": "npm run sync && cd android && ./gradlew assembleRelease",
    "build:aab": "npm run sync && cd android && ./gradlew bundleRelease"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/status-bar": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.4",
    "tailwindcss": "^3.4.17"
  }
}
